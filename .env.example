# Masukkan cookie dari https://gemini.google.com (lihat di DevTools -> F12 -> Application -> Cookies atau Network)
GEMINI_SECURE_1PSID=ISI_DENGAN_SECURE_1PSID_KAMU
GEMINI_SECURE_1PSIDTS=ISI_DENGAN_SECURE_1PSIDTS_KAMU

# Model default (misalnya gemini-pro atau gemini-flash)
DEFAULT_MODEL=gemini-pro

# Konfigurasi Server
PORT=8000
HOST=127.0.0.1
